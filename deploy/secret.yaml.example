apiVersion: v1
kind: Secret
metadata:
  name: kleinanzeigen-monitor-secrets
  namespace: kleinanzeigen-monitor
type: Opaque
stringData:
  OPENROUTER_API_KEY: REPLACE_ME
  TELEGRAM_BOT_TOKEN: REPLACE_ME
  TELEGRAM_CHAT_ID: REPLACE_ME
  # Optional: omit both OTEL entries to disable telemetry.
  # OTEL_EXPORTER_OTLP_ENDPOINT: https://your-otlp-endpoint/otlp
  # OTEL_EXPORTER_OTLP_HEADERS: Authorization=Basic%20YOUR_BASE64_CREDENTIALS
